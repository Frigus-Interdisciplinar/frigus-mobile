<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FrigusApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frigus_mobile"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="frigus_reminders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_status" />

        <service
            android:name=".push.FrigusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.createaccount.CreateAccountActivity"
            android:exported="false" />

        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipes.ReceitaDetalhesActivity"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".ui.notifications.NotificacoesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stock.TodasCategoriasActivity"
            android:enabled="false"
            android:exported="false" />

        <activity
            android:name=".ui.stock.CategoriaItensActivity"
            android:enabled="false"
            android:exported="false" />

        <activity
            android:name=".ui.stock.AlimentoDetalhesActivity"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".ui.stock.EditarAlimentoActivity"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".ui.ai.ChatIaActivity"
            android:exported="false" />

    </application>
</manifest>
