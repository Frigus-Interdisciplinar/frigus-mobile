<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lotDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pure_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lot_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lotBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/lot_touch"
            android:text="@string/lot_back" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/lot_detail_title"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/lot_title"
            android:layout_marginTop="@dimen/lot_gap"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <ProgressBar
            android:id="@+id/lotProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:contentDescription="@string/inventory_loading" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/lotStatus"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_loading"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/lot_body"
            android:layout_marginTop="@dimen/lot_gap"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lotReload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/lot_touch"
            android:text="@string/lot_reload" />
        <LinearLayout
            android:id="@+id/lotContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvDetalhesNome"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_unknown"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_title"
                android:layout_marginTop="@dimen/lot_gap"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lotInformation"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_unknown"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_movements_pending"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:text="@string/lot_edit" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoverEstoque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:text="@string/lot_remove"
                app:backgroundTint="@color/profile_red" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>