<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnVoltarAdicionarItemLista"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lista_voltar"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/darkBlue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/sarabun"
            android:text="@string/lista_adicionar_item"
            android:textColor="@color/darkBlue"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_nome"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNomeItemLista"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:fontFamily="@font/sarabun"
                android:hint="@string/lista_nome_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_quantidade"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etQuantidadeLista"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/sarabun"
                    android:hint="@string/lista_quantidade_hint"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/darkBlue"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/color_card_border" />

                <Spinner
                    android:id="@+id/spinnerUnidadeLista"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/lista_unidade"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_categoria"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategoriaLista"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:contentDescription="@string/lista_categoria"
                android:paddingHorizontal="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_observacoes"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacoesLista"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:background="@drawable/bg_search_bar"
                android:fontFamily="@font/sarabun"
                android:gravity="top|start"
                android:hint="@string/lista_observacoes_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarItemLista"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_salvar"
                android:textAllCaps="false"
                android:textColor="@color/pure_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
