<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shopping_screen_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnVoltarAdicionarItemLista"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lista_voltar"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/darkBlue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/sarabun"
            android:text="@string/lista_adicionar_item"
            android:textColor="@color/darkBlue"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="189dp"
                android:layout_height="144dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/bg_shopping_product_photo"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/imgProdutoAdicionarLista"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/lista_imagem_produto"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_food_package"
                    app:tint="@color/blue_primary"
                    tools:ignore="ContentDescription" />

                <ImageButton
                    android:id="@+id/btnCameraAdicionarItemLista"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="-10dp"
                    android:background="@drawable/bg_stock_add_button"
                    android:contentDescription="@string/lista_adicionar_foto"
                    android:padding="12dp"
                    android:src="@drawable/ic_shopping_camera"
                    app:tint="@color/pure_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_onde_adicionar"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDestinoAdicionarLista"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_shopping_destination_group"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/rbDestinoEstoqueLista"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shopping_destination_unselected"
                    android:button="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sarabun"
                    android:gravity="center"
                    android:text="@string/lista_destino_estoque"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbDestinoListaCompras"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.25"
                    android:background="@drawable/bg_shopping_destination_selected"
                    android:button="@null"
                    android:checked="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sarabun"
                    android:gravity="center"
                    android:text="@string/lista_destino_lista_compras"
                    android:textColor="@color/pure_white"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Qual lugar do estoque? (Exibido apenas quando Estoque selecionado) -->
            <LinearLayout
                android:id="@+id/layoutLugarEstoque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/lista_qual_lugar_estoque"
                    android:textColor="@color/darkBlue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_shopping_list_field">

                    <Spinner
                        android:id="@+id/spinnerLugarEstoque"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@string/lista_qual_lugar_estoque"
                        android:paddingHorizontal="14dp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="14dp"
                        android:clickable="false"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/darkBlue" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_nome"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/etNomeItemLista"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_shopping_list_field"
                android:completionThreshold="1"
                android:dropDownHeight="200dp"
                android:fontFamily="@font/sarabun"
                android:hint="@string/lista_nome_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Coluna Esquerda: Quantidade -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/lista_quantidade"
                        android:textColor="@color/darkBlue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etQuantidadeLista"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_shopping_list_field"
                        android:fontFamily="@font/sarabun"
                        android:hint="@string/lista_quantidade_hint"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/darkBlue"
                        android:textColorHint="@color/color_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Coluna Direita: Unidade de medida -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/lista_unidade_medida"
                        android:textColor="@color/darkBlue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_shopping_list_field">

                        <Spinner
                            android:id="@+id/spinnerUnidadeLista"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:contentDescription="@string/lista_unidade_medida"
                            android:paddingStart="14dp"
                            android:paddingEnd="36dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="14dp"
                            android:clickable="false"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/darkBlue" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Validade (Exibido apenas quando Estoque selecionado) -->
            <LinearLayout
                android:id="@+id/layoutValidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLabelValidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/lista_data_validade_obrigatoria"
                    android:textColor="@color/darkBlue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/layoutValidadeInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_shopping_list_field">

                    <EditText
                        android:id="@+id/etValidadeLista"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:fontFamily="@font/sarabun"
                        android:hint="@string/lista_validade_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="42dp"
                        android:singleLine="true"
                        android:textColor="@color/darkBlue"
                        android:textColorHint="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/ivValidadeCalendario"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="14dp"
                        android:clickable="false"
                        android:src="@drawable/ic_calendar_outline"
                        app:tint="@color/darkBlue" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_categoria"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_shopping_list_field">

                <Spinner
                    android:id="@+id/spinnerCategoriaLista"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:contentDescription="@string/lista_categoria"
                    android:paddingHorizontal="14dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:clickable="false"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/darkBlue" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/lista_observacoes_opcional"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacoesLista"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_shopping_list_field"
                android:fontFamily="@font/sarabun"
                android:gravity="top|start"
                android:hint="@string/lista_observacoes_hint_estoque"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarItemLista"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/lista_salvar"
                    android:textAllCaps="false"
                    android:textColor="@color/pure_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/blue_primary"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progressSalvarItemLista"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/pure_white"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>