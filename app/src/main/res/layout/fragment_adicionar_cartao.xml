<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/darkBlue"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="18sp"
                android:text="@string/profile_add_card"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:maxLines="1"
                android:ellipsize="end"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@drawable/bg_card_blue_tint">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_profile_figma_creditcard"
                android:contentDescription="@null"
                android:layout_gravity="top|start"/>
            <TextView
                android:id="@+id/tvPreviewNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="•••• ••••"/>
            <TextView
                android:id="@+id/tvPreviewBandeira"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="@string/profile_card_holder"
            android:layout_marginTop="20dp"/>
        <EditText
            android:id="@+id/etNomeCartao"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_white_rounded"
            android:hint="@string/profile_card_holder_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapCharacters"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:fontFamily="@font/sarabun"
            android:textSize="12sp"
            android:textColor="@color/darkBlue"
            android:textColorHint="@color/gray"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="@string/profile_card_number"
            android:layout_marginTop="14dp"/>
        <EditText
            android:id="@+id/etNumeroCartao"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_white_rounded"
            android:hint="@string/profile_card_number_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="19"
            android:paddingHorizontal="14dp"
            android:fontFamily="@font/sarabun"
            android:textSize="12sp"
            android:textColor="@color/darkBlue"
            android:textColorHint="@color/gray"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="@string/profile_card_expiry"/>
                <EditText
                    android:id="@+id/etValidadeCartao"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:hint="@string/profile_card_expiry_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingHorizontal="14dp"
                    android:fontFamily="@font/sarabun"
                    android:textSize="12sp"
                    android:textColor="@color/darkBlue"
                    android:textColorHint="@color/gray"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="@string/profile_card_cvv"/>
                <EditText
                    android:id="@+id/etCvvCartao"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:hint="@string/profile_card_cvv_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:fontFamily="@font/sarabun"
                    android:textSize="12sp"
                    android:textColor="@color/darkBlue"
                    android:textColorHint="@color/gray"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="@string/profile_card_cpf"
            android:layout_marginTop="14dp"/>
        <EditText
            android:id="@+id/etCpfCartao"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_white_rounded"
            android:hint="@string/profile_card_cpf_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="14"
            android:paddingHorizontal="14dp"
            android:fontFamily="@font/sarabun"
            android:textSize="12sp"
            android:textColor="@color/darkBlue"
            android:textColorHint="@color/gray"/>
        <CheckBox
            android:id="@+id/cbCartaoPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="@string/profile_card_make_default"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarCartao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/profile_save_card"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/pure_white"
            app:backgroundTint="@color/blue1"
            app:cornerRadius="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="8dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield_check"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/gray"
                android:textSize="10sp"
                android:text="@string/profile_card_security_note"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
