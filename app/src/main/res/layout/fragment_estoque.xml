<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inventoryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/inventory_page_padding">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_title"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_title_size"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/inventoryRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:text="@string/inventory_refresh"
            android:layout_marginTop="@dimen/inventory_gap" />
        <LinearLayout
            android:id="@+id/inventorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inventory_section_gap"
            android:orientation="vertical"
            android:background="@drawable/bg_card_blue_tint"
            android:padding="@dimen/inventory_section_gap"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_group_summary"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/inventory_heading_size"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inventorySummaryText"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_unknown"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/inventory_body_size"
                android:layout_marginTop="@dimen/inventory_gap" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_summary_note"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/inventory_body_size"
                android:layout_marginTop="@dimen/inventory_gap" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_stock_label"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:labelFor="@id/inventoryStock"
            android:layout_marginTop="@dimen/inventory_gap" />
        <Spinner
            android:id="@+id/inventoryStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:spinnerMode="dropdown" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_place_label"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:labelFor="@id/inventoryPlace"
            android:layout_marginTop="@dimen/inventory_gap" />
        <Spinner
            android:id="@+id/inventoryPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:spinnerMode="dropdown" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_category_label"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:labelFor="@id/inventoryCategory"
            android:layout_marginTop="@dimen/inventory_gap" />
        <Spinner
            android:id="@+id/inventoryCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:spinnerMode="dropdown" />
        <EditText
            android:id="@+id/etBuscarAlimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:layout_marginTop="@dimen/inventory_gap"
            android:background="@drawable/bg_search_bar"
            android:padding="@dimen/inventory_gap"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:textColorHint="@color/color_text_secondary"
            android:textSize="@dimen/inventory_body_size"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:hint="@string/inventory_search" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_results"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_heading_size"
            android:layout_marginTop="@dimen/inventory_section_gap"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_read_only"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:layout_marginTop="@dimen/inventory_gap" />
        <TextView
            android:id="@+id/inventoryAllStatusesNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inventory_gap"
            android:fontFamily="@font/sarabun"
            android:text="@string/navigation_inventory_all_statuses"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/inventoryProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/inventory_gap"
            android:contentDescription="@string/inventory_loading"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/inventoryStatus"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_loading"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/inventory_body_size"
            android:layout_marginTop="@dimen/inventory_section_gap"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/inventoryRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:text="@string/inventory_retry"
            android:layout_marginTop="@dimen/inventory_gap"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProximosVencimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inventory_gap"
            android:nestedScrollingEnabled="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/inventoryMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inventory_touch_target"
            android:text="@string/inventory_more"
            android:layout_marginTop="@dimen/inventory_gap"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
