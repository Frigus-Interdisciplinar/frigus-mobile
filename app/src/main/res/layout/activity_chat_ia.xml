<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ai_space_16"
        android:paddingTop="@dimen/ai_space_16"
        android:paddingBottom="@dimen/ai_space_12">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="@dimen/ai_back_size"
            android:layout_height="@dimen/ai_back_size"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/pure_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ai_space_8"
            android:layout_toEndOf="@id/btnVoltar"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/ai_title"
                android:textColor="@color/pure_white"
                android:textSize="@dimen/ai_text_18"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/ai_subtitle"
                android:textColor="@color/ai_subtitle"
                android:textSize="@dimen/ai_text_12" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/ai_space_20"
        android:paddingBottom="@dimen/ai_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_rounded"
                android:orientation="vertical"
                android:padding="@dimen/ai_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_select_stock_label"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/ai_text_16"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_4"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_stock_note"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/ai_text_13" />

                <Spinner
                    android:id="@+id/aiStockSelector"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ai_selector_height"
                    android:layout_marginTop="@dimen/ai_space_12"
                    android:contentDescription="@string/ai_select_stock_label" />

                <ProgressBar
                    android:id="@+id/aiStockProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ai_space_4"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/aiStockStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_8"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/ai_text_13" />

                <Button
                    android:id="@+id/aiStockRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ai_space_16"
                android:background="@drawable/bg_card_white_rounded"
                android:orientation="vertical"
                android:padding="@dimen/ai_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_suggestions_title"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/ai_text_16"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_4"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_suggestions_note"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/ai_text_13" />

                <Button
                    android:id="@+id/aiRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_8"
                    android:enabled="false"
                    android:text="@string/ai_refresh" />

                <ProgressBar
                    android:id="@+id/aiSuggestionsProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ai_space_4"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/aiSuggestionsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_8"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_choose_stock"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/ai_text_13" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/aiSuggestionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_space_8"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ai_space_16"
                android:fontFamily="@font/sarabun"
                android:gravity="center"
                android:text="@string/ai_chat_unavailable"
                android:textColor="@color/pure_white"
                android:textSize="@dimen/ai_text_12" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
