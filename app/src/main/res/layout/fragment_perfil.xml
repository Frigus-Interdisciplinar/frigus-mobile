<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/account_page_padding">
        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_title"
            android:textSize="@dimen/account_title_size"
            android:textColor="@color/darkBlue"
            android:accessibilityHeading="true"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="@dimen/account_avatar_size"
            android:layout_height="@dimen/account_avatar_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/account_section_gap"
            android:padding="@dimen/account_avatar_padding"
            android:background="@drawable/bg_avatar_circle"
            android:src="@drawable/ic_person"
            android:contentDescription="@null"
            app:tint="@color/profile_primary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_read_only"
            android:textSize="@dimen/account_body_size"
            android:textColor="@color/darkBlue"
            android:layout_marginTop="@dimen/account_section_gap" />
        <ProgressBar
            android:id="@+id/accountProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/account_gap"
            android:contentDescription="@string/account_loading"
            android:visibility="gone" />
        <TextView
            android:id="@+id/accountStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_loading"
            android:textSize="@dimen/account_body_size"
            android:textColor="@color/darkBlue"
            android:layout_marginTop="@dimen/account_gap"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/accountReload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/account_gap"
            android:minHeight="@dimen/account_touch_target"
            android:text="@string/account_refresh" />
        <LinearLayout
            android:id="@+id/accountFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_name"
                android:textSize="@dimen/account_label_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_section_gap"
                android:labelFor="@id/tvNomeUsuario" />
            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_not_informed"
                android:textSize="@dimen/account_body_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_gap"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_email"
                android:textSize="@dimen/account_label_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_section_gap"
                android:labelFor="@id/tvEmailUsuario" />
            <TextView
                android:id="@+id/tvEmailUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_not_informed"
                android:textSize="@dimen/account_body_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_gap"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_birth_date"
                android:textSize="@dimen/account_label_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_section_gap"
                android:labelFor="@id/accountBirthDate" />
            <TextView
                android:id="@+id/accountBirthDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_not_informed"
                android:textSize="@dimen/account_body_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_gap"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_type"
                android:textSize="@dimen/account_label_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_section_gap"
                android:labelFor="@id/accountType" />
            <TextView
                android:id="@+id/accountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/account_not_informed"
                android:textSize="@dimen/account_body_size"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="@dimen/account_gap"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_security_title"
            android:textSize="@dimen/account_heading_size"
            android:textColor="@color/darkBlue"
            android:layout_marginTop="@dimen/account_section_gap"
            android:accessibilityHeading="true"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_security_unavailable"
            android:textSize="@dimen/account_body_size"
            android:textColor="@color/darkBlue"
            android:layout_marginTop="@dimen/account_gap" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/account_other_unavailable"
            android:textSize="@dimen/account_body_size"
            android:textColor="@color/darkBlue"
            android:layout_marginTop="@dimen/account_gap" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/account_section_gap"
            android:minHeight="@dimen/account_touch_target"
            android:text="@string/account_logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
