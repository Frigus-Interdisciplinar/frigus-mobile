<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:text="@string/profile_perfil"
            android:id="@+id/tvTituloPerfil"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@string/profile_avatar"
            android:id="@+id/ivAvatar"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_avatar_circle"
            android:padding="20dp"
            app:tint="@color/profile_primary"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/darkBlue"
            android:id="@+id/tvNomeUsuario"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Juliana Martins"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/gray"
            android:id="@+id/tvEmailUsuario"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="12sp"
            tools:text="juliana.martins@email.com"/>
        <LinearLayout
            android:id="@+id/cardPlanoPremium"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="23dp"
            android:background="@drawable/bg_card_white_rounded"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:id="@+id/tvNomePlanoPerfil"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Plano Free"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/gray"
                    android:id="@+id/tvValidadePlanoPerfil"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    tools:text="Válido até 25/12/2026"/>
            </LinearLayout>
            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_crown"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white_rounded"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:id="@+id/btnAssinaturaPlanos"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_figma_subscription"
                    android:contentDescription="@null"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_plans"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/profile_divider"/>
            <LinearLayout
                android:id="@+id/btnConfiguracoes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_figma_sliders"
                    android:contentDescription="@null"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_settings"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/profile_divider"/>
            <LinearLayout
                android:id="@+id/btnAjudaSuporte"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_figma_help"
                    android:contentDescription="@null"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_support"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/groupMoneySaving"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@color/profile_divider"/>
                <LinearLayout
                    android:id="@+id/btnMoneySaving"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_trending_up"
                        android:contentDescription="@null"
                        android:layout_marginStart="6dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:textColor="@color/darkBlue"
                            android:text="@string/profile_money_saving"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:textColor="@color/gray"
                            android:text="@string/profile_money_saving_subtitle"
                            android:textSize="10sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        app:tint="@color/darkBlue"
                        android:layout_marginEnd="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/profile_divider"/>
            <LinearLayout
                android:id="@+id/btnSair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_figma_logout"
                    android:contentDescription="@null"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/profile_red"
                    android:text="@string/profile_sign_out"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
