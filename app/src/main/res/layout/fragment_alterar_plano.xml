<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pure_white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="@dimen/plans_top_padding" android:paddingBottom="@dimen/plans_page_padding">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="@dimen/plans_header_height">
            <ImageButton android:id="@+id/btnVoltar" android:layout_width="@dimen/account_touch_target" android:layout_height="@dimen/account_touch_target" android:layout_marginStart="4dp" android:paddingHorizontal="15.5dp" android:paddingVertical="6.5dp" android:rotation="180" android:scaleType="fitCenter" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/profile_back" android:src="@drawable/plan_figma_back" />
            <TextView style="@style/RecoveredPlanTitle" android:layout_width="wrap_content" android:layout_height="27dp" android:layout_centerInParent="true" android:includeFontPadding="false" android:gravity="center" android:text="@string/profile_choose_plan" android:textSize="20sp" />
        </RelativeLayout>
        <TextView style="@style/RecoveredPlanText" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="-2dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/plans_choose_subtitle" android:textColor="@color/plans_secondary_text" android:textSize="12sp" />
        <HorizontalScrollView android:id="@+id/planCarouselScroll" android:layout_width="match_parent" android:layout_height="@dimen/plans_carousel_height" android:layout_marginTop="18dp" android:paddingHorizontal="@dimen/plans_carousel_padding" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/containerPlanos" android:layout_width="wrap_content" android:layout_height="@dimen/plans_card_height" android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/indicadoresPlanos" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="15dp" android:gravity="center" android:orientation="horizontal" />
        <ProgressBar android:id="@+id/progressPlanos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="@string/subscription_loading" />
        <TextView android:id="@+id/tvPlanosVazio" style="@style/RecoveredPlanText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/subscription_no_plans" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
