<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="100dp"
            android:paddingBottom="130dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_stock_remove_icon">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stock_remove" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:fontFamily="@font/sarabun"
                android:gravity="center"
                android:text="@string/stock_remove_question"
                android:textColor="@color/darkBlue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_card_white_rounded"
                android:gravity="center_vertical"
                android:minHeight="126dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgAlimentoRemocao"
                    android:layout_width="96dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_stock_product_image"
                    android:contentDescription="@string/stock_product_image"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNomeAlimentoRemocao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:maxLines="2"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Nome do alimento" />

                    <TextView
                        android:id="@+id/tvQuantidadeAlimentoRemocao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sarabun"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="Quantidade" />

                    <TextView
                        android:id="@+id/tvValidadeAlimentoRemocao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sarabun"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="Validade" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:fontFamily="@font/sarabun"
                android:gravity="center"
                android:text="@string/stock_remove_warning"
                android:textColor="@color/color_red"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/pure_white"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="56dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelarRemocao"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white_rounded"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_cancel"
            android:textAllCaps="false"
            android:textColor="@color/darkBlue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmarRemocao"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stock_remove_button"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_remove"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
