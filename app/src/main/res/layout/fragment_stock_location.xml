<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white">

    <!-- A barra inferior pertence a activity_main.xml. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnVoltarLocalEstoque"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stock_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/darkBlue" />

            <LinearLayout
                android:id="@+id/btnSelecionarLocalEstoque"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:clickable="true"
                android:contentDescription="@string/stock_select_location"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvLocalEstoque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Geladeira" />

                <ImageView
                    android:id="@+id/imgSetaLocalEstoque"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/darkBlue" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/gray" />

            <EditText
                android:id="@+id/etBuscarAlimentosLocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/sarabun"
                android:hint="@string/stock_search_food_plural"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/gray"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoriasLocalEstoque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlimentosLocal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:paddingBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_stock_location_product" />

            <ProgressBar
                android:id="@+id/progressoAlimentosLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/stock_loading"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAlimentosLocalVazio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_empty_location"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAlimentosLocalErro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_load_error"
                android:textColor="@color/color_red"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Estado do frame 3763:11509; abrir e selecionar o menu exige ligação futura. -->
    <LinearLayout
        android:id="@+id/menuLocaisEstoque"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="58dp"
        android:background="@drawable/bg_stock_location_menu"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/opcaoGeladeiraEstoque"
            style="@style/StockLocationOption"
            android:drawableStart="@drawable/ic_fridge"
            android:text="@string/stock_fridge" />

        <TextView
            android:id="@+id/opcaoFreezerEstoque"
            style="@style/StockLocationOption"
            android:drawableStart="@drawable/ic_freezer"
            android:text="@string/stock_freezer" />

        <TextView
            android:id="@+id/opcaoDespensaEstoque"
            style="@style/StockLocationOption"
            android:drawableStart="@drawable/ic_pantry"
            android:text="@string/stock_pantry" />
    </LinearLayout>
</FrameLayout>
