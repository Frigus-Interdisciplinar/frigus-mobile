<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="@dimen/recipe_browser_touch"
    android:padding="@dimen/recipe_browser_section_gap"
    android:layout_marginTop="@dimen/recipe_browser_gap"
    android:background="@drawable/bg_card_white_rounded"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtRecipePopularTitle"
        android:fontFamily="@font/sarabun"
        android:text="@string/recipe_browser_unnamed"
        android:textColor="@color/darkBlue"
        android:textSize="@dimen/recipe_browser_heading"
        android:layout_marginTop="@dimen/recipe_browser_gap"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recipeRowDescription"
        android:fontFamily="@font/sarabun"
        android:text="@string/recipe_browser_no_description"
        android:textColor="@color/darkBlue"
        android:textSize="@dimen/recipe_browser_body"
        android:layout_marginTop="@dimen/recipe_browser_gap" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recipeRowAvailability"
        android:fontFamily="@font/sarabun"
        android:text="@string/recipe_browser_not_informed"
        android:textColor="@color/darkBlue"
        android:textSize="@dimen/recipe_browser_body"
        android:layout_marginTop="@dimen/recipe_browser_gap"
        android:visibility="gone" />
    <TextView
        android:id="@+id/recipeRowFavoriteStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/darkBlue"
        android:textSize="@dimen/recipe_browser_body"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/recipeRowFavorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/recipe_browser_touch"
        android:visibility="gone"
        android:text="@string/recipe_favorite_add" />
</LinearLayout>
