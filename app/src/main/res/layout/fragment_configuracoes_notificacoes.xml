<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pure_white" android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="18dp"
        android:paddingTop="32dp" android:paddingBottom="24dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp">
            <ImageButton android:id="@+id/btnVoltar" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_alignParentStart="true" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_back" android:src="@drawable/ic_chevron_left"
                app:tint="@color/darkBlue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_centerInParent="true" android:layout_marginHorizontal="48dp"
                android:fontFamily="@font/sarabun" android:gravity="center"
                android:text="@string/profile_notifications" android:textColor="@color/darkBlue"
                android:textSize="18sp" android:textStyle="bold" />
        </RelativeLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="60dp" android:fontFamily="@font/sarabun"
            android:text="@string/profile_alerts_food" android:textColor="@color/profile_primary"
            android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="16dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_blue">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_vencimento"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_expiring"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_expiring_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchExpiring" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_expiring"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_red">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_acabando"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_low_stock"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_low_stock_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLowStock" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_low_stock"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_yellow">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_receitas"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_recipes"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_recipes_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRecipes" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_recipes"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="34dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_green">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_lista"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_shopping"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_shopping_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchShopping" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_shopping"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_pink">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_promocoes"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_promotions"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_promotions_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPromotions" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_promotions"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="68dp" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="11dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_profile_notification_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                android:background="@drawable/bg_profile_notification_blue">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center" android:src="@drawable/ic_profile_notification_resumo"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun" android:text="@string/profile_alert_daily"
                    android:textColor="@color/darkBlue" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:fontFamily="@font/sarabun"
                    android:text="@string/profile_alert_daily_detail" android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDaily" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="44dp"
                android:contentDescription="@string/profile_alert_daily"
                app:thumbTint="@color/pure_white"
                app:trackTint="@color/profile_preference_switch_track"
                app:useMaterialThemeColors="false" tools:checked="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
