<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProdutoListaCompras"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <CheckBox
            android:id="@+id/checkProdutoListaCompras"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:buttonTint="@color/blue_primary"
            android:contentDescription="@string/lista_marcar_item"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeProdutoLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalhesProdutoLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgAbrirProdutoLista"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/lista_editar_item"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/darkBlue" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
