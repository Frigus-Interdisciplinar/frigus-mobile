<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/btnVoltar" android:layout_width="wrap_content"
            android:layout_height="48dp" android:gravity="center_vertical"
            android:text="‹  Voltar" android:textColor="@color/darkBlue" android:textSize="18sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MoneySaving" android:textStyle="bold" android:textSize="22sp"
            android:textColor="@color/darkBlue" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/previousMonth" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Anterior"/>
            <TextView android:id="@+id/periodLabel" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/darkBlue"/>
            <Button android:id="@+id/nextMonth" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Próximo"/>
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginVertical="12dp"
            android:textColor="@color/darkBlue"/>
        <Button android:id="@+id/retry" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Tentar novamente"
            android:visibility="gone"/>
        <TextView android:id="@+id/summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/darkBlue" android:lineSpacingExtra="6dp"
            android:background="@drawable/bg_card_blue_tint" android:padding="16dp"/>
        <TextView android:id="@+id/categories" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:textColor="@color/darkBlue" android:background="@drawable/bg_card_white_rounded"
            android:padding="12dp"/>
        <TextView android:id="@+id/months" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:textColor="@color/darkBlue" android:background="@drawable/bg_card_white_rounded"
            android:padding="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Histórico"
            android:textStyle="bold" android:textSize="18sp" android:textColor="@color/darkBlue"/>
        <Spinner android:id="@+id/categoryFilter" android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <Spinner android:id="@+id/kindFilter" android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <LinearLayout android:id="@+id/events" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/loadMore" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Carregar mais" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
