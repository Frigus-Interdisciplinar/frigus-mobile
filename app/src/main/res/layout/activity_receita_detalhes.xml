<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:id="@+id/recipeDetailRoot">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRecipeDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageButton
                    android:id="@+id/btnDetailBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@string/recipe_browser_back"
                    app:tint="@color/darkBlue" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/recipe_browser_title"
                    android:textColor="@color/darkBlue"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/recipeDetailProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/recipe_browser_loading"
                android:visibility="gone" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/recipeDetailStatus"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_loading"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:layout_marginTop="@dimen/recipe_browser_gap"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recipeDetailRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recipe_browser_touch"
                android:text="@string/recipe_browser_retry"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/pure_white"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp"
                android:id="@+id/recipeDetailContent"
                android:visibility="gone">
                <TextView
                    android:id="@+id/txtDetailRecipeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtDetailRecipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/sarabun"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/txtDetailIngredientsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/recipe_ingredients_title"
                    android:textColor="@color/darkBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/recipeIngredientsState"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/recipe_browser_no_ingredients"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/recipe_browser_body"
                    android:layout_marginTop="@dimen/recipe_browser_gap" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_card_border"
                    app:cardBackgroundColor="@color/recipe_ingredient_card">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:id="@+id/layoutRecipeInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_recipe_instructions"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="visible">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/recipe_instructions_title"
                        android:textColor="@color/darkBlue"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtDetailRecipeInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/sarabun"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:text="@string/recipe_browser_no_instructions"
                        android:textIsSelectable="true" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/recipe_browser_availability_unknown"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/recipe_browser_body"
                    android:layout_marginTop="@dimen/recipe_browser_gap" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/recipe_browser_read_only"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/recipe_browser_body"
                    android:layout_marginTop="@dimen/recipe_browser_gap" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/pure_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerModoPreparo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/blue_primary"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_view_instructions"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
