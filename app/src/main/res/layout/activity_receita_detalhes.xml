<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipeDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pure_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/recipe_browser_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/recipe_browser_touch"
            android:text="@string/recipe_browser_back" />
        <ProgressBar
            android:id="@+id/recipeDetailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/recipe_browser_loading"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/recipeDetailStatus"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_loading"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/recipe_browser_body"
            android:layout_marginTop="@dimen/recipe_browser_gap"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recipeDetailRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/recipe_browser_touch"
            android:text="@string/recipe_browser_retry"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/recipeDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/txtDetailRecipeTitle"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_unnamed"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_title"
                android:layout_marginTop="@dimen/recipe_browser_gap"
                android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/txtDetailRecipeDescription"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_no_description"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:layout_marginTop="@dimen/recipe_browser_gap" />
            <TextView
                android:id="@+id/recipeDetailFavoriteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recipeDetailFavorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recipe_browser_touch"
                android:text="@string/recipe_favorite_add" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_ingredients"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_heading"
                android:layout_marginTop="@dimen/recipe_browser_section_gap"
                android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/recipeIngredientsState"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_no_ingredients"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:layout_marginTop="@dimen/recipe_browser_gap" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_availability_unknown"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:layout_marginTop="@dimen/recipe_browser_gap" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/recipe_browser_read_only"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/recipe_browser_body"
                android:layout_marginTop="@dimen/recipe_browser_gap" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerModoPreparo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recipe_browser_touch"
                android:text="@string/recipe_browser_preparation" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
