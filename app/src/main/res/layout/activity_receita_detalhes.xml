<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRecipeDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Banner with Floating Buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgRecipeHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_frango_molho_cremoso"
                    android:contentDescription="Foto da receita" />

                <!-- Floating Back Button -->
                <FrameLayout
                    android:id="@+id/btnDetailBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/pure_white"
                        android:contentDescription="Voltar" />
                </FrameLayout>

                <!-- Floating Heart/Favorite Button -->
                <FrameLayout
                    android:id="@+id/btnDetailFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imgFavoriteIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/pure_white"
                        android:contentDescription="Favoritar receita" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Sheet Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_top_rounded"
                android:layout_marginTop="-20dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Recipe Title -->
                <TextView
                    android:id="@+id/txtDetailRecipeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Frango ao molho cremoso" />

                <!-- Meta row: Rating, Time, Difficulty -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/color_gold" />

                    <TextView
                        android:id="@+id/txtDetailRecipeRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="4,8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="•"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailRecipeTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="35 min" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="•"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailRecipeDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="Fácil" />
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/txtDetailRecipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/sarabun"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="14sp"
                    tools:text="Uma receita prática e deliciosa para o dia a dia." />

                <!-- Section: Usa ingredientes que você tem -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/sarabun"
                    android:text="Usa ingredientes que você tem"
                    android:textColor="@color/darkBlue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Chips Container -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupIngredientsInStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp" />

                <!-- Section: Ingredientes (N) -->
                <TextView
                    android:id="@+id/txtDetailIngredientsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/sarabun"
                    android:text="Ingredientes (4)"
                    android:textColor="@color/darkBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Ingredients Card Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_card_border"
                    app:cardBackgroundColor="@color/pure_white">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_recipe_ingredient" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button Container -->
    <FrameLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/pure_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerModoPreparo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/blue_primary"
            android:fontFamily="@font/sarabun"
            android:text="Ver modo de preparo"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
