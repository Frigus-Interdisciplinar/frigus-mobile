<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white_rounded"
    android:padding="24dp">

    <!-- Ícone Central -->
    <FrameLayout
        android:id="@+id/layoutIconeSaida"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_stock_remove_icon">

        <ImageView
            android:id="@+id/imgIconeSaida"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_savings"
            android:contentDescription="@null"
            app:tint="@color/color_green" />
    </FrameLayout>

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloSaida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/sarabun"
        android:gravity="center"
        android:textColor="@color/darkBlue"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Registrar Consumo" />

    <!-- Subtítulo / Impacto MoneySaving -->
    <TextView
        android:id="@+id/tvSubtituloSaida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/sarabun"
        android:gravity="center"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp"
        tools:text="Essa ação soma economia real no seu Money-Saving." />

    <!-- Card Resumo do Produto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_blue_tint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgAlimentoSaida"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_stock_product_image"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeAlimentoSaida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Peito de Frango" />

            <TextView
                android:id="@+id/tvDetalhesAlimentoSaida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/gray"
                android:textSize="12sp"
                tools:text="Disponível: 3 un • Validade: 10/11/2026" />
        </LinearLayout>
    </LinearLayout>

    <!-- Seletor de Quantidade -->
    <LinearLayout
        android:id="@+id/layoutSeletorQuantidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="Quantidade:"
            android:textColor="@color/darkBlue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDiminuirQtd"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outlined_blue"
            android:text="-"
            android:textColor="@color/blue_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuantidadeSaida"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:gravity="center"
            android:textColor="@color/darkBlue"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAumentarQtd"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outlined_blue"
            android:text="+"
            android:textColor="@color/blue_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTudoQtd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/sarabun"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Tudo"
            android:textColor="@color/blue_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botões de Ação do Diálogo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelarSaida"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white_rounded"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_cancel"
            android:textAllCaps="false"
            android:textColor="@color/darkBlue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmarSaida"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_solid_green"
            android:fontFamily="@font/sarabun"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
