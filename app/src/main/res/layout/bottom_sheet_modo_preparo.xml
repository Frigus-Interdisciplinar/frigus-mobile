<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/pure_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/recipe_browser_padding">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtSheetRecipeTitle"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_preparation"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/recipe_browser_heading"
            android:layout_marginTop="@dimen/recipe_browser_gap"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtSheetInstructions"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_no_instructions"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/recipe_browser_body"
            android:layout_marginTop="@dimen/recipe_browser_gap"
            android:textIsSelectable="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFecharModoPreparo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/recipe_browser_touch"
            android:text="@string/recipe_browser_close" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
