<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/pure_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_top_rounded"
        android:orientation="vertical"
        android:padding="24dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chip_ingredient" />
        <TextView
            android:id="@+id/txtSheetRecipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_preparation"
            android:textColor="@color/darkBlue"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_read_only"
            android:textColor="@color/gray"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtSheetInstructions"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_no_instructions"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/recipe_browser_body"
            android:layout_marginTop="@dimen/recipe_browser_gap"
            android:textIsSelectable="true"
            android:lineSpacingExtra="5dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFecharModoPreparo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/blue_primary"
            android:fontFamily="@font/sarabun"
            android:text="@string/recipe_browser_close"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
