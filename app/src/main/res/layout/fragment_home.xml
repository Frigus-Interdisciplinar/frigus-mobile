<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:id="@+id/homeScroll">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:layout_toStartOf="@id/btnNotificacoes">
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_greeting"
                    android:textColor="@color/darkBlue"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/home_body_size" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/btnNotificacoes"
                android:layout_width="@dimen/home_touch_size"
                android:layout_height="@dimen/home_touch_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_navy"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_notifications_pending">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/pure_white"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/homeProgress"
            android:layout_width="@dimen/home_progress_size"
            android:layout_height="@dimen/home_progress_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/home_spacing_medium"
            android:visibility="gone" />
        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_spacing_medium"
            android:text="@string/home_loading"
            android:textSize="@dimen/home_body_size"
            android:textColor="@color/color_text_secondary"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeReloadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_spacing_small"
            android:text="@string/home_refresh" />
        <LinearLayout
            android:id="@+id/homeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/homeEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_spacing_medium"
                android:text="@string/home_empty_stock"
                android:textSize="@dimen/home_body_size"
                android:textColor="@color/color_text_secondary"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout
                android:id="@+id/cardAlertaVencendo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_danger"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_cancel"
                    app:tint="@color/color_red"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvAlertaVencendoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_unknown_count"
                        android:textColor="@color/profile_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_details_pending"
                        android:textColor="@color/profile_red"
                        android:textSize="@dimen/home_body_size" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_red"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/cardQuickEstoque"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_food_package"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:text="@string/home_stock"
                            android:textColor="@color/darkBlue"
                            android:textSize="@dimen/home_body_size"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvQuickEstoqueQtd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:text="@string/home_unknown_count"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/home_body_size" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardQuickReceitas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_restaurant"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:text="@string/home_recipes"
                            android:textColor="@color/darkBlue"
                            android:textSize="@dimen/home_body_size"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sarabun"
                            android:text="@string/home_feature_pending"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/home_body_size" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/home_your_stock"
                android:textColor="@color/darkBlue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/cardEstoqueGeladeira"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_fridge"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_fridge"
                        android:textColor="@color/darkBlue"
                        android:textSize="@dimen/home_body_size"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvQtdGeladeira"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_unknown_count"
                        android:textColor="@color/blue_primary"
                        android:textSize="@dimen/home_body_size" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardEstoqueFreezer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_freezer"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_freezer"
                        android:textColor="@color/darkBlue"
                        android:textSize="@dimen/home_body_size"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvQtdFreezer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_unknown_count"
                        android:textColor="@color/blue_primary"
                        android:textSize="@dimen/home_body_size" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardEstoqueDespensa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_pantry"
                        app:tint="@color/blue_primary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_pantry"
                        android:textColor="@color/darkBlue"
                        android:textSize="@dimen/home_body_size"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvQtdDespensa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun"
                        android:text="@string/home_unknown_count"
                        android:textColor="@color/blue_primary"
                        android:textSize="@dimen/home_body_size" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/homeAllPlacesNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_spacing_medium"
                android:text="@string/home_all_places_note"
                android:textSize="@dimen/home_body_size"
                android:textColor="@color/color_text_secondary"
                android:accessibilityLiveRegion="polite" />
            <TextView
                android:id="@+id/homeStatusNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_spacing_medium"
                android:text="@string/home_expiration_unknown"
                android:textSize="@dimen/home_body_size"
                android:textColor="@color/color_text_secondary"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <TextView
            android:id="@+id/homePendingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_spacing_medium"
            android:text="@string/home_other_features"
            android:textSize="@dimen/home_body_size"
            android:textColor="@color/darkBlue"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/cardChats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat_sparkle"
                app:tint="@color/blue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_conversations"
                    android:textColor="@color/darkBlue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSubtituloChats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_feature_pending"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/home_body_size" />
            </LinearLayout>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/color_text_secondary"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardEscanearQrCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_qr_code_scanner"
                app:tint="@color/blue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_qr"
                    android:textColor="@color/darkBlue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvHomeQrSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_qr_description"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/home_body_size" />
            </LinearLayout>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/color_text_secondary"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardFaleComIa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_chat_sparkle"
                app:tint="@color/pure_white"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/home_ai"
                    android:textColor="@color/pure_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/ai_home_entry_label"
                    android:textColor="#E0EAFF"
                    android:textSize="@dimen/home_body_size" />
            </LinearLayout>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/pure_white"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
