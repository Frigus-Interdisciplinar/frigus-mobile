<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qr_confirmation_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/black" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="166dp"
                android:layout_height="166dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="52dp"
                android:background="@drawable/bg_qr_success_halo"
                android:contentDescription="@string/qr_confirm_success_icon">

                <View
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center"
                    android:background="@drawable/profile_success_circle" />

                <ImageView
                    android:layout_width="51dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_profile_success_check" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:fontFamily="@font/sarabun"
                android:gravity="center"
                android:text="@string/qr_confirm_title"
                android:textColor="@color/darkBlue"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sarabun"
                android:gravity="center"
                android:text="@string/qr_confirm_subtitle"
                android:textColor="@color/qr_confirmation_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVoltarInicio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="132dp"
                android:background="@drawable/bg_qr_success_outline_button"
                android:fontFamily="@font/sarabun"
                android:text="@string/qr_confirm_back_home"
                android:textAllCaps="false"
                android:textColor="@color/qr_confirmation_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
