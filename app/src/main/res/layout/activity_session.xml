<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/pure_white">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintWidth_max="@dimen/auth_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical" android:padding="32dp" android:fitsSystemWindows="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auth_access_confirmed" android:textAppearance="?attr/textAppearanceHeadline5" />
        <TextView android:id="@+id/sessionIdentity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBody1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/auth_features_pending"
            android:textAppearance="?attr/textAppearanceBody1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSessionLogout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/auth_sign_out" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
