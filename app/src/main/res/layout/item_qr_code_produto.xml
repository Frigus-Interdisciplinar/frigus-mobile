<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white_rounded"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvQrItemNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/darkBlue"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQrItemDescricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvQrItemPreco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/darkBlue"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvQrItemDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/color_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvQrItemEvidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/color_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvQrItemMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/sarabun"
        android:textColor="@color/blue_primary"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/qrIncludeItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/sarabun"
        android:text="@string/receipt_include_item"
        android:textColor="@color/darkBlue"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/qrImportControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnDiminuirQtd"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:contentDescription="@string/receipt_quantity_decrease"
            android:focusable="true"
            android:fontFamily="@font/sarabun"
            android:gravity="center"
            android:text="@string/receipt_quantity_decrease_symbol"
            android:textColor="@color/blue_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQrItemQtd"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:gravity="center"
            android:textColor="@color/darkBlue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAumentarQtd"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:contentDescription="@string/receipt_quantity_increase"
            android:focusable="true"
            android:fontFamily="@font/sarabun"
            android:gravity="center"
            android:text="@string/receipt_quantity_increase_symbol"
            android:textColor="@color/blue_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQrExpireDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/receipt_expiration_choose"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
