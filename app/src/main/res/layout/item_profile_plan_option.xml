<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="@dimen/plans_card_width" android:layout_height="@dimen/plans_card_height" android:layout_marginEnd="8dp" android:orientation="vertical" android:background="@drawable/bg_plan_carousel_card" android:paddingHorizontal="@dimen/plans_card_inner_padding" android:paddingTop="@dimen/plans_card_top" android:paddingBottom="@dimen/plans_card_bottom">
    <FrameLayout android:layout_width="@dimen/plans_card_icon" android:layout_height="@dimen/plans_card_icon" android:layout_gravity="center_horizontal">
        <ImageView android:id="@+id/ivPlanoFundo" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/plan_figma_free_bg" android:contentDescription="@null" />
        <ImageView android:id="@+id/ivPlanoIcone" android:layout_width="@dimen/plans_card_glyph" android:layout_height="@dimen/plans_card_glyph" android:layout_gravity="center" android:src="@drawable/plan_figma_free" android:contentDescription="@null" />
    </FrameLayout>
    <TextView android:id="@+id/tvPlanoOpcaoNome" style="@style/RecoveredPlanTitle" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="@dimen/plans_card_title_gap" android:gravity="center" android:includeFontPadding="false" />
    <TextView android:id="@+id/tvPlanoOpcaoPreco" style="@style/RecoveredPlanText" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="8dp" android:gravity="center" android:includeFontPadding="false" android:textSize="15sp" android:textStyle="bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/plans_card_features_gap" android:scrollbars="none">
        <LinearLayout android:id="@+id/containerBeneficios" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnEscolherPlano" android:layout_width="match_parent" android:layout_height="@dimen/plans_card_button_height" android:layout_marginTop="16dp" android:minHeight="0dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:fontFamily="@font/sarabun" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/pure_white" app:backgroundTint="@color/blue1" app:cornerRadius="11dp" />
</LinearLayout>
