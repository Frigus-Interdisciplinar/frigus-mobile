<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stock_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/darkBlue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_edit"
                android:textColor="@color/darkBlue"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Imagem do Alimento -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgEditarAlimento"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/pure_white"
            android:contentDescription="@string/stock_product_image"
            android:scaleType="centerInside"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent" />

        <!-- Campo: Nome do alimento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_food_name"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNomeAlimento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:fontFamily="@font/sarabun"
            android:hint="@string/stock_food_name"
            android:paddingHorizontal="14dp"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp" />

        <!-- Campo: Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_category"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="14dp" />

        <!-- Campo: Local -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_location"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLocal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="14dp" />

        <!-- Campo: Validade -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_expiration"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etValidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:fontFamily="@font/sarabun"
            android:hint="@string/stock_expiration_hint"
            android:inputType="date"
            android:paddingHorizontal="14dp"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp" />

        <!-- Campo: Quantidade total -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/sarabun"
            android:text="@string/stock_total_quantity"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuantidadeTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:fontFamily="@font/sarabun"
                android:hint="@string/stock_quantity_hint"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerUnidade"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarAlteracoes"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/sarabun"
        android:text="@string/stock_save_changes"
        android:textAllCaps="false"
        android:textColor="@color/pure_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/blue_primary"
        app:cornerRadius="10dp" />
</FrameLayout>
