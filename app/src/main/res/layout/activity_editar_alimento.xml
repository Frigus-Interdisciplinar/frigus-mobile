<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lotEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pure_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lot_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lotBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/lot_touch"
            android:text="@string/lot_back" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:text="@string/lot_edit_title"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/lot_title"
            android:layout_marginTop="@dimen/lot_gap"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <ProgressBar
            android:id="@+id/lotProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:contentDescription="@string/inventory_loading" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/lotStatus"
            android:fontFamily="@font/sarabun"
            android:text="@string/inventory_loading"
            android:textColor="@color/darkBlue"
            android:textSize="@dimen/lot_body"
            android:layout_marginTop="@dimen/lot_gap"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lotReload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/lot_touch"
            android:text="@string/lot_reload" />
        <LinearLayout
            android:id="@+id/lotForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_form_note"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lotUnit"
                android:fontFamily="@font/sarabun"
                android:text="@string/inventory_unknown"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_name"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/etNomeAlimento" />
            <EditText
                android:id="@+id/etNomeAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="textCapSentences"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_quantity"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/etQuantidadeTotal" />
            <EditText
                android:id="@+id/etQuantidadeTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="number"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_initial"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/lotInitialQuantity" />
            <EditText
                android:id="@+id/lotInitialQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="number"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_minimum"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/lotMinimum" />
            <EditText
                android:id="@+id/lotMinimum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="number"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_expiry"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/etValidade" />
            <EditText
                android:id="@+id/etValidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="date"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_batch"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/lotBatch" />
            <EditText
                android:id="@+id/lotBatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:inputType="text"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_category"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/spinnerCategoria" />
            <Spinner
                android:id="@+id/spinnerCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:spinnerMode="dropdown" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:text="@string/lot_place"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/lot_body"
                android:layout_marginTop="@dimen/lot_gap"
                android:labelFor="@id/spinnerLocal" />
            <Spinner
                android:id="@+id/spinnerLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:spinnerMode="dropdown" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lot_touch"
                android:text="@string/lot_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>