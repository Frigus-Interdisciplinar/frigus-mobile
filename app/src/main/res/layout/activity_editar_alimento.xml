<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="100dp">

            <!-- Top Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnVoltar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stock_back"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/darkBlue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/stock_edit"
                    android:textColor="@color/darkBlue"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Container da Imagem do Alimento com Botão de Câmera -->
            <FrameLayout
                android:id="@+id/layoutFotoEditarAlimento"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/bg_card_white_rounded">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgEditarAlimento"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/stock_product_image"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarFotoAlimento"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginBottom="-4dp"
                    android:contentDescription="Alterar foto do alimento"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/blue_primary"
                    app:cornerRadius="19dp"
                    app:elevation="4dp"
                    app:icon="@drawable/ic_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/pure_white" />
            </FrameLayout>

            <!-- Campo 1: Nome do alimento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_food_name"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNomeAlimento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_shopping_list_field"
                android:fontFamily="@font/sarabun"
                android:hint="@string/stock_food_name"
                android:paddingHorizontal="14dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="14sp" />

            <!-- Campo 2: Local (Primeiro) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_location"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_shopping_list_field">

                <Spinner
                    android:id="@+id/spinnerLocal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:dropDownVerticalOffset="4dp"
                    android:paddingHorizontal="14dp"
                    android:popupBackground="@color/pure_white" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:clickable="false"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/darkBlue" />
            </FrameLayout>

            <!-- Campo 3: Categoria (Atualizada pelo Local) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_category"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_shopping_list_field">

                <Spinner
                    android:id="@+id/spinnerCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:dropDownVerticalOffset="4dp"
                    android:paddingHorizontal="14dp"
                    android:popupBackground="@color/pure_white" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:clickable="false"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/darkBlue" />
            </FrameLayout>

            <!-- Campo 4: Validade (DatePicker >= Hoje) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_expiration"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etValidade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_shopping_list_field"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@drawable/ic_calendar_outline"
                android:drawablePadding="10dp"
                android:drawableTint="@color/darkBlue"
                android:focusable="false"
                android:fontFamily="@font/sarabun"
                android:hint="@string/stock_expiration_hint"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="14sp" />

            <!-- Campo 5: Quantidade Total + Unidade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/stock_total_quantity"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etQuantidadeTotal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shopping_list_field"
                    android:fontFamily="@font/sarabun"
                    android:hint="@string/stock_quantity_hint"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shopping_list_field">

                    <Spinner
                        android:id="@+id/spinnerUnidade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:dropDownVerticalOffset="4dp"
                        android:paddingHorizontal="12dp"
                        android:popupBackground="@color/pure_white" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:clickable="false"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/darkBlue" />
                </FrameLayout>
            </LinearLayout>

            <!-- Campo 6: Observações (opcional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/sarabun"
                android:text="Observações (opcional)"
                android:textColor="@color/darkBlue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacoesAlimento"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:background="@drawable/bg_shopping_list_field"
                android:fontFamily="@font/sarabun"
                android:gravity="top|start"
                android:hint="Ex.: marca, preferências..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarAlteracoes"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/sarabun"
        android:text="@string/stock_save_changes"
        android:textAllCaps="false"
        android:textColor="@color/pure_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/blue_primary"
        app:cornerRadius="10dp" />
</FrameLayout>
