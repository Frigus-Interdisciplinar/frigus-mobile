<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_help_outline"
            app:tint="@color/blue_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="Requisitos da Senha"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/sarabun"
        android:lineSpacingExtra="2dp"
        android:text="Para sua segurança, a senha deve atender aos seguintes critérios:"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp" />

    <!-- Critério 1: 8 caracteres -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvReq8Chars"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/dialogTvReq8Chars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="De 8 a 20 caracteres"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Critério 2: Letra maiúscula -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvReqUpper"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/dialogTvReqUpper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="Pelo menos uma letra maiúscula (A-Z)"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Critério 3: Letra minúscula -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvReqLower"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/dialogTvReqLower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="Pelo menos uma letra minúscula (a-z)"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Critério 4: Número -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvReqNumber"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/dialogTvReqNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="Pelo menos um número (0-9)"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Critério 5: Caractere especial -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvReqSpecial"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/dialogTvReqSpecial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sarabun"
            android:text="Pelo menos um caractere especial (!@#$...)"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Botão Fechar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntendiSenha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="@font/sarabun"
        android:text="Entendi"
        android:textAllCaps="false"
        android:textColor="@color/pure_white"
        android:textSize="15sp"
        app:backgroundTint="@color/blue_primary"
        app:cornerRadius="10dp" />

</LinearLayout>
