<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="190dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/color_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <!-- Opção Geladeira -->
        <LinearLayout
            android:id="@+id/opcaoGeladeira"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_fridge"
                app:tint="@color/blue_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/sarabun"
                android:text="Geladeira"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkGeladeira"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_circle_check"
                android:visibility="visible"
                app:tint="@color/blue_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/color_card_border" />

        <!-- Opção Freezer -->
        <LinearLayout
            android:id="@+id/opcaoFreezer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_freezer"
                app:tint="@color/blue_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/sarabun"
                android:text="Freezer"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkFreezer"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_circle_check"
                android:visibility="gone"
                app:tint="@color/blue_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/color_card_border" />

        <!-- Opção Despensa -->
        <LinearLayout
            android:id="@+id/opcaoDespensa"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pantry"
                app:tint="@color/blue_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/sarabun"
                android:text="Despensa"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkDespensa"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_circle_check"
                android:visibility="gone"
                app:tint="@color/blue_primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
