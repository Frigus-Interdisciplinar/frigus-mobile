<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/darkBlue"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:text="@string/profile_support"
                android:layout_centerInParent="true"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </RelativeLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarabun"
            android:textColor="@color/profile_primary"
            android:text="@string/profile_faq_title"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white_rounded"
            android:layout_marginTop="0dp"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:id="@+id/btnFaqScanner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_faq_scanner"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white_rounded"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:id="@+id/btnFaqManual"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_faq_manual"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white_rounded"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:id="@+id/btnFaqQuantidade"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_faq_quantity"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/groupFaqMoneySaving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white_rounded"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="12dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/btnFaqMoneySaving"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun"
                    android:textColor="@color/darkBlue"
                    android:text="@string/profile_faq_money_saving"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:textSize="13sp"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null"
                    app:tint="@color/darkBlue"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_profile_contact"
            android:layout_marginBottom="22dp"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/darkBlue"
                android:text="@string/profile_contact_title"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun"
                android:textColor="@color/gray"
                android:text="@string/profile_contact_detail"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrarContato"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/profile_contact_button"
                android:textAllCaps="false"
                android:textColor="@color/pure_white"
                android:textSize="13sp"
                android:fontFamily="@font/sarabun"
                app:backgroundTint="@color/profile_primary"
                app:cornerRadius="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
