<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="84dp" android:paddingHorizontal="16dp">
    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_person" android:contentDescription="@null" android:id="@+id/ivMembroAvatar" android:background="@drawable/bg_avatar_circle" android:padding="10dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/sarabun" android:textColor="@color/darkBlue" android:textSize="14sp" android:id="@+id/tvMembroNome" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/sarabun" android:textColor="@color/gray" android:textSize="12sp" android:id="@+id/tvMembroFuncao" android:layout_marginTop="5dp" />
    </LinearLayout>
</LinearLayout>