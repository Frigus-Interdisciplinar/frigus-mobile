<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="32dp">
    <TextView android:id="@+id/unavailableMessage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBody1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnUnavailableBack"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/auth_back_login" />
</LinearLayout>
