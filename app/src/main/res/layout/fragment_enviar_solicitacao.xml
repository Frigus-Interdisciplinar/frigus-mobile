<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageButton
                    android:id="@+id/btnVoltar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_back"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/darkBlue"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/sarabun"
                    android:text="@string/profile_request_title"
                    android:textColor="@color/darkBlue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </RelativeLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/profile_request_how_help"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/profile_request_subject"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etAssunto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_settings_password_field"
                android:fontFamily="@font/sarabun"
                android:hint="@string/profile_request_subject_hint"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/gray"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/profile_request_description"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etDescricao"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_settings_password_field"
                android:fontFamily="@font/sarabun"
                android:gravity="top|start"
                android:hint="@string/profile_request_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:padding="12dp"
                android:textColor="@color/darkBlue"
                android:textColorHint="@color/gray"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sarabun"
                android:text="@string/profile_request_info"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/sarabun"
        android:text="@string/profile_request_send"
        android:textAllCaps="false"
        android:textColor="@color/pure_white"
        android:textSize="15sp"
        app:backgroundTint="@color/blue1"
        app:cornerRadius="10dp"/>
</FrameLayout>
