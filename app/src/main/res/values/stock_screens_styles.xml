<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StockCategoryChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_stock_category_chip</item>
        <item name="android:fontFamily">@font/sarabun</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/darkBlue</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StockLocationOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">@font/sarabun</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/darkBlue</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
