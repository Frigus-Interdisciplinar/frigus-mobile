    <string name="money_saving_how_calculated_title">Como os valores são calculados</string>
    <string name="money_saving_calc_prices_title">De onde vêm os preços?</string>
    <string name="money_saving_calc_prices_desc">Os valores dos alimentos são obtidos a partir das notas fiscais escaneadas. Utilizamos o preço pago no momento da compra.</string>
    <string name="money_saving_calc_used_title">Alimento aproveitado</string>
    <string name="money_saving_calc_used_desc">Consideramos aproveitado quando o alimento é consumido antes da data de validade ou ainda dentro do período seguro.</string>
    <string name="money_saving_calc_discarded_title">Alimento descartado</string>
    <string name="money_saving_calc_discarded_desc">Consideramos descartado quando o alimento passa da data de validade e é removido do estoque sem ter sido consumido.</string>
    <string name="money_saving_calc_disclaimer">Os valores apresentados são estimativos e podem variar de acordo com peso, unidade e atualizações de preço.</string>

