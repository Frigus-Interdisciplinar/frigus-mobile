rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{owner}/shopping_list/{item} {
      allow read: if request.auth != null && request.auth.uid == owner;
      allow create, update: if request.auth != null && request.auth.uid == owner
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'quantity', 'unit', 'unitCode', 'categoryCode', 'observation',
          'checked', 'revision', 'deleted', 'updatedAt'
        ])
        && request.resource.data.revision is string
        && request.resource.data.deleted is bool
        && (request.resource.data.deleted == true || (
          request.resource.data.id == item
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0 && request.resource.data.quantity <= 2147483647
          && request.resource.data.checked is bool
          && request.resource.data.unit is string
          && request.resource.data.unitCode is string
          && request.resource.data.categoryCode is string
          && request.resource.data.observation is string
          && request.resource.data.observation.size() <= 2000
        ));
      allow delete: if false;
    }
  }
}
